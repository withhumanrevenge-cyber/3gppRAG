# Copy to .env. Every value has a working default; nothing here is required.

# --- Generation -------------------------------------------------------------
# auto (default) picks whichever key is present, else runs extractive-only.
# TELCORAG_LLM=groq
# GROQ_API_KEY=
# OPENAI_API_KEY=
# TELCORAG_LLM_MODEL=llama-3.3-70b-versatile
# OLLAMA_HOST=http://localhost:11434

# --- Retrieval --------------------------------------------------------------
# TELCORAG_EMBEDDINGS=auto        # auto | st | lsa
# TELCORAG_EMBED_MODEL=BAAI/bge-small-en-v1.5
# TELCORAG_RERANKER=auto          # auto | cross-encoder | lexical
# TELCORAG_FINAL_K=6

# --- Abstention gate --------------------------------------------------------
# Raise to refuse more often, lower to answer more often.
# TELCORAG_MIN_TOP_SCORE=0.20
# TELCORAG_MIN_SUPPORT=0.18
# TELCORAG_MIN_OVERLAP=0.08
# TELCORAG_MIN_SENT_SUPPORT=0.45
# TELCORAG_DROP_UNVERIFIED=1      # 0 keeps unverified claims, flagged
